{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with basic info",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "updatedAt": { "type": "timestamp" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["email"]
    },
    "Project": {
      "title": "Project",
      "description": "A generated script project",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "script": { "type": "string" },
        "character": { "type": "map" },
        "scenes": { "type": "list" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["ownerId", "script", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profile document."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "Project" },
      "description": "Projects generated by users."
    }
  }
}
