rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isVerified() {
      // Allow Google Auth which verified email by default, but local emulation needs to just rely on token.email_verified
      return request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'updatedAt']) 
        && data.email is string && data.email.size() <= 200
        && data.updatedAt == request.time
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('createdAt' in data) || data.createdAt == request.time);
    }
    
    function isValidProject(data) {
      return data.keys().hasAll(['ownerId', 'script', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && data.script is string && data.script.size() <= 50000
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && (!('character' in data) || data.character is map)
        && (!('scenes' in data) || (data.scenes is list && data.scenes.size() <= 200))
        && (!('audience' in data) || data.audience is string)
        && (!('targetPlatform' in data) || data.targetPlatform is string)
        && (!('promptLanguage' in data) || data.promptLanguage is string)
        && (!('directorStyle' in data) || data.directorStyle is string)
        && (!('qualityScore' in data) || data.qualityScore is map)
        && (!('viralOptimizer' in data) || data.viralOptimizer is map)
        && (!('narrativeArc' in data) || data.narrativeArc is map)
        && (!('stressTest' in data) || data.stressTest is list);
    }
    
    function isValidProjectUpdate(data, old) {
      return data.ownerId == old.ownerId
        && data.createdAt == old.createdAt
        && data.updatedAt == request.time
        && (!('character' in data) || data.character is map)
        && (!('scenes' in data) || (data.scenes is list && data.scenes.size() <= 200))
        && (!('audience' in data) || data.audience is string)
        && (!('targetPlatform' in data) || data.targetPlatform is string)
        && (!('promptLanguage' in data) || data.promptLanguage is string)
        && (!('directorStyle' in data) || data.directorStyle is string)
        && (!('qualityScore' in data) || data.qualityScore is map)
        && (!('viralOptimizer' in data) || data.viralOptimizer is map)
        && (!('narrativeArc' in data) || data.narrativeArc is map)
        && (!('stressTest' in data) || data.stressTest is list);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isVerified() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isVerified() && isValidId(userId) && request.auth.uid == userId
        && incoming().keys().hasAll(['email', 'updatedAt']) && incoming().keys().size() <= 4
        && isValidUser(incoming());
      allow update: if isSignedIn() && isVerified() && isValidId(userId) && request.auth.uid == userId
        && incoming().diff(existing()).affectedKeys().hasAny(['email', 'displayName', 'photoURL', 'updatedAt'])
        && (!('createdAt' in incoming().diff(existing()).affectedKeys()))
        && isValidUser(incoming());
    }

    match /projects/{projectId} {
      allow get: if isSignedIn() && isVerified() && isValidId(projectId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && isVerified() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn() && isVerified() && isValidId(projectId)
        && isValidProject(incoming());
        
      allow update: if isSignedIn() && isVerified() && isValidId(projectId) && existing().ownerId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasAny(['script', 'character', 'scenes', 'updatedAt'])
        && (!('createdAt' in incoming().diff(existing()).affectedKeys()))
        && (!('ownerId' in incoming().diff(existing()).affectedKeys()))
        && isValidProjectUpdate(incoming(), existing());
        
      allow delete: if isSignedIn() && isVerified() && isValidId(projectId) && existing().ownerId == request.auth.uid;
    }
  }
}
